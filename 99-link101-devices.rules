# udev rules for RoboCore Link101 USB devices
#
# Installation:
#   sudo cp 99-link101-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ENV{ID_USB_INTERFACE_NUM}=="01", \
    SYMLINK+="link101-rs485", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ENV{ID_USB_INTERFACE_NUM}=="03", \
    SYMLINK+="link101-servo", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ENV{ID_USB_INTERFACE_NUM}=="05", \
    SYMLINK+="link101-serial1", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ENV{ID_USB_INTERFACE_NUM}=="07", \
    SYMLINK+="link101-serial2", MODE="0666", GROUP="dialout"

# Only present if ENABLE_UART2 is defined in firmware
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ENV{ID_USB_INTERFACE_NUM}=="09", \
    SYMLINK+="link101-serial3", MODE="0666", GROUP="dialout"