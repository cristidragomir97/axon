# udev rules for RoboCore Axon USB devices
# Creates simple /dev/axon-* symlinks (single device only)
# 
# Installation:
#   sudo cp 99-axon-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# RoboCore Axon Multiprotocol Bridge (VID:PID = 1209:AC01)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ATTRS{interface}=="RoboCore Axon RS485", \
    SYMLINK+="axon-rs485", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ATTRS{interface}=="RoboCore Axon Motor", \
    SYMLINK+="axon-motor", MODE="0666", GROUP="dialout"

# Legacy compatibility symlinks
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ATTRS{interface}=="RoboCore Axon Motor", \
    SYMLINK+="axon-feetech axon-dynamixel", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ATTRS{interface}=="RoboCore Axon UART0", \
    SYMLINK+="axon-uart0 axon-serial1", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ATTRS{interface}=="RoboCore Axon UART1", \
    SYMLINK+="axon-uart1 axon-serial2", MODE="0666", GROUP="dialout"

# Optional UART2 (only present if ENABLE_UART2 is defined in firmware)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="ac01", ATTRS{interface}=="RoboCore Axon UART2", \
    SYMLINK+="axon-uart2 axon-serial3", MODE="0666", GROUP="dialout"